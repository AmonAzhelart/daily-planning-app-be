{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Uvicorn",
      "type": "python",
      "request": "launch",
      // Lancia uvicorn come un modulo Python
      "module": "uvicorn",
      "args": [
        // Questo è il riferimento alla tua istanza FastAPI
        // Corrisponde a "app.main:app" nel tuo comando
        "app.main:app",
        // Il flag --reload è utile per lo sviluppo,
        // ma a volte può causare la disconnessione del debugger.
        // Se riscontri problemi, prova a rimuovere la riga seguente.
        "--reload"
      ],
      // Abilita il debug per i template Jinja2, se li usi con FastAPI
      "jinja": true
    }
  ]
}
